{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CP: Build (debug)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "-O0",
        "-std=c++17",
        "-Wall",
        "-DLOCAL_DEBUG",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}_tests/sol-debug.bin"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
